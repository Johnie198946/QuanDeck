{
  "name": "quandeck",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node scripts/test.mjs",
    "preview": "vite preview",
    "format": "oxfmt",
    "bridge": "node scripts/agent-bridge.mjs",
    "desktop:setup": "npm install --prefix desktop && npm ci --prefix desktop/app --omit=optional --ignore-scripts",
    "desktop:package": "pnpm build && node desktop/package.mjs",
    "desktop:mac": "pnpm build && node desktop/package.mjs --mac",
    "desktop:windows": "pnpm build && node desktop/package.mjs --win",
    "release:check": "node scripts/clean-release.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
